# Copy to .env on the server and fill in. .env holds secrets: never commit it, never paste it into chat.

# Model service. Type the key into .env yourself on the server.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Backup model service (optional), any OpenAI-compatible chat API. It answers only when DeepSeek has failed before
# its first word: no reply within 4 seconds for speech (30 for background tasks), a refused request (429, 5xx, no credit,
# bad key) or no connection. DeepSeek is then skipped for 30 seconds after 3 failures in a row. Leave empty for none.
# VOICE_LLM_BACKUP_BASE_URL=
# VOICE_LLM_BACKUP_API_KEY=
# VOICE_LLM_BACKUP_MODEL=
# The backup's own request fields as JSON; for a DeepSeek model on another host: {"thinking": {"type": "disabled"}}
# VOICE_LLM_BACKUP_EXTRA_BODY=
# Its price, yuan per million tokens, from the backup's own price page (no off-peak discount is applied). Without it
# the spend page counts its calls as unpriced rather than free.
# VOICE_LLM_BACKUP_PRICE={"hit": 0.2, "miss": 2.0, "output": 8.0}

# Database (PostgreSQL in docker compose). Two different long random passwords, typed here yourself:
# POSTGRES_PASSWORD is the database administrator's, VOICE_DB_PASSWORD the app's own (a role without superuser
# rights, so row-level security applies to it). Both are read when the database is first created; changing them
# later means changing them inside PostgreSQL too.
POSTGRES_PASSWORD=
VOICE_DB_PASSWORD=
# Connections the app keeps open to the database.
# VOICE_DB_POOL=10

# The public address of the site, exactly as visitors type it (scheme and host, no trailing slash).
VOICE_ALLOWED_ORIGINS=https://example.com
# Cookies only over HTTPS.
VOICE_SECURE_COOKIE=1
# open, or closed to allow only accounts created with manage.py.
VOICE_REGISTRATION=open

# Speech recognition: how many at once (each uses 2 CPU threads; about half the server's cores).
VOICE_ASR_CONCURRENCY=2
# Background agents: spending cap per user per day, in yuan.
VOICE_DAILY_BUDGET_YUAN=2

# Rate limits, "count/seconds". Defaults shown.
# VOICE_RATE_AUTH=20/60
# VOICE_RATE_TURN=30/60
# VOICE_RATE_UPLOAD=30/3600
# VOICE_RATE_LOOKUP=60/60
# VOICE_RATE_TASK=20/3600

# Speech output. edge-tts is for trying things out; a domestic commercial TTS service replaces it before opening up.
VOICE_TTS_PROVIDER=edge
# Pronunciation scoring: not set until a provider is chosen.
# VOICE_PRON_PROVIDER=
